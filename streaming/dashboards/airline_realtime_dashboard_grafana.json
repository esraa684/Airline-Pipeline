                        "pluginVersion": "4.22.1",
                        "queryType": "table",
                        "rawSql": "SELECT\r\n    DepartureHour AS hour,\r\n    round(\r\n        countIf(IsDelayed = 1) * 100.0 / count(),\r\n        2\r\n    ) AS delay_rate\r\nFROM airline_db.flights_processed\r\nWHERE DepartureHour IS NOT NULL\r\nGROUP BY hour\r\nORDER BY hour"
                      }
                    },
